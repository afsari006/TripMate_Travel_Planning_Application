<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-Bleed Real Mountain Forest Photo Background -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img"
        android:contentDescription="Front Travel Image" />

    <!-- Dark Scrim Overlay for Readability -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_scrim" />

    <!-- Top App Logo Branding & Glass Badge -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|start"
        android:layout_marginTop="95dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- Dual-Tone Title: Trip (White) + Mate (Sky Blue) -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛰ "
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mate"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

        </LinearLayout>

        <!-- Subtitle Underneath TripMate in Vibrant Sky Blue Color -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Smart Travel Companion"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginTop="2dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Light Badge with Solid Black Text -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Explore Beaches • Mountains • Heritage Sites"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_light_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- Bottom Content Layout Positioned Higher -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="50dp">

        <!-- Subtitle with Blue Accent Line -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your journey, beautifully planned"
            android:textSize="16sp"
            android:textColor="#F1F5F9"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <View
            android:layout_width="45dp"
            android:layout_height="3dp"
            android:background="#38BDF8"
            android:layout_marginTop="6dp" />

        <!-- Large Headline: Discover Your Next Escape -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover Your"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Escape"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <!-- Feature Chips Bar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌎 12+ Destinations"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Smart Budget"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ Live Weather"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" />

        </LinearLayout>

        <!-- Start Exploring Button -->

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Start Exploring ➔"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_rounded_button"
            app:backgroundTint="@null"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</FrameLayout>